---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <div class="archive">
    <header>
      <h1 class="tertiary text-lg">Page not found</h1>
    </header>
    <p>That page doesn't exist, or it's moved. <a href="/" data-astro-prefetch>Back home <span class="inline-block relative text-2xl top-0.5">☞</span></a></p>
  </div>
</Layout>
