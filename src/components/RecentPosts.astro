---
import { format } from 'date-fns';
import Tags from './Tags.astro';
import { getPublishedPosts, sortByDate } from '../lib/posts';

const filteredPosts = sortByDate(await getPublishedPosts());

// Get the newest post tagged with 'post'
const featuredPost = filteredPosts.find(post => post.data.tags?.includes('post'));

// Exclude featured post from recent posts
const recentPosts = filteredPosts
  .filter(post => post.id !== featuredPost?.id)
  .slice(0, 8);
---

<section>
  <div class="featured">
    {featuredPost && (
      <article>
        <h3>
          <span class="text-sm tertiary block weight-base mb-1">NEWEST POST · · ·</span>
          <a href={`/p/${featuredPost.id}`} data-astro-prefetch>{featuredPost.data.title}</a>
        </h3>
        <p style="margin-block: 8px;">{featuredPost.data.description} <a href={`/p/${featuredPost.id}`} data-astro-prefetch> <nobr class="ml-1">Continue <span class="inline-block relative text-2xl top-0.5" style="margin-block: -8px;">☞</span></nobr></a></p>
      </article>
    )}
  </div>
  <h2 class="mb-3 text-sm tertiary">EXPLORE · · ·</h2>
  <div class="posts grid gap-y-3">
    {
      recentPosts.map((post) => (
          <article class="post">
            <h3>
              <a href={`/p/${post.id}`} class="post-link" data-astro-prefetch>{post.data.title}</a>
            </h3>
            <div class="grid ml-1">
              <div class="truncate lite">· · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · </div>
            </div>
            <div class="tags text-sm ml-1">
              {post.data.tags.map((tag) => (
                <a href={`/t/${tag}`} class={`tag ${tag}`} data-astro-prefetch>{tag}</a>
              ))}
            </div>
            <span class="lite hidden ml-1 sm:block" style="">·</span>
            <time datetime={post.data.pubDate.toISOString()} class="text-sm hidden ml-1 sm:block">
              { post.data.tendDate ? format(post.data.tendDate, 'MMM yyyy') : format(post.data.pubDate, 'MMM yyyy')}
            </time>
          </article>
      ))
    }
  </div>
  <Tags />
  <div class="mt-4 mb-4">
    <a href="/p" data-astro-prefetch>View everything <span class="inline-block relative text-2xl top-0.5">☞</span></a>
  </div>

</section>